{
  "name": "@wimm/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "prisma generate && node ./scripts/clean-dist.cjs && nest build && tsc-alias -p tsconfig.build.json",
    "dev": "pnpm --filter @wimm/shared run build && prisma generate && node ./scripts/ensure-nest-main.cjs && nest start --watch --exec \"node -r ./scripts/register-prisma-paths.js\"",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch --exec \"node -r ./scripts/register-prisma-paths.js\"",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "clean": "rm -rf dist src/generated",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:personal": "tsx scripts/seed-personal-rules.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@wimm/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^17.4.2",
    "jest": "^30.3.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^7.7.0",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.5.0"
  }
}
