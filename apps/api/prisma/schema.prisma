generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  username             String                @unique
  passwordHash         String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  refreshTokens        RefreshToken[]
  sources              Source[]
  categories           Category[]
  transactions         Transaction[]
  importBatches        ImportBatch[]
  recurrences          Recurrence[]
  categorizationRules  CategorizationRule[]
}

enum SourceType {
  BANK_ACCOUNT
  CREDIT_CARD
  CASH
  MANUAL
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionKind {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceEndMode {
  INDEFINITE
  UNTIL_DATE
}

model Source {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           SourceType
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]
  importBatches  ImportBatch[]
  recurrences    Recurrence[]

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  type                 CategoryType
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  transactions         Transaction[]
  recurrences          Recurrence[]
  categorizationRules  CategorizationRule[]

  @@unique([userId, name])
  @@index([userId])
}

enum CategorizationMatchType {
  CONTAINS
  EQUALS
}

model CategorizationRule {
  id          String                   @id @default(uuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  priority    Int
  matchType   CategorizationMatchType
  pattern     String
  categoryId  String
  category    Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([userId, priority])
}

enum ImportBatchFormat {
  CSV
  OFX
}

enum ImportBatchStatus {
  COMPLETED
}

model ImportBatch {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId     String
  source       Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fileName     String
  format       ImportBatchFormat
  status       ImportBatchStatus  @default(COMPLETED)
  createdAt    DateTime           @default(now())
  transactions Transaction[]

  @@index([userId])
  @@index([sourceId])
}

model Recurrence {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         TransactionKind
  amount       Decimal              @db.Decimal(14, 2)
  description  String
  sourceId     String?
  source       Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency    RecurrenceFrequency
  startDate    DateTime
  endMode      RecurrenceEndMode
  endDate      DateTime?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId       String?
  source         Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatchId  String?
  importBatch    ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  recurrenceId   String?
  recurrence     Recurrence?       @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  kind           TransactionKind
  amount         Decimal           @db.Decimal(14, 2)
  description    String
  occurredAt     DateTime
  fingerprint    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, occurredAt])
  @@index([userId])
  @@index([userId, fingerprint])
  @@index([recurrenceId, occurredAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
