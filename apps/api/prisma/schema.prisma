generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  username             String                @unique
  passwordHash         String
  /** UI language: `en` | `pt` */
  preferredLocale      String                @default("pt")
  /** Drives which date a credit card expense bucks into in reports. */
  chartDateMode        String                @default("BILLING_CYCLE")
  /** Set when the user finishes the onboarding flow. NULL = show onboarding. */
  onboardedAt          DateTime?
  /** Paywall scaffolding (no enforcement yet — defaults make every user pass). */
  subscriptionStatus   String                @default("ACTIVE")
  subscriptionPlan     String?
  trialEndsAt          DateTime?
  /** 1..200 for lifetime Founder slot; NULL otherwise. Granted via CLI script. */
  founderNumber        Int?                  @unique
  /** AI categorization preference; default OFF — opt-in, never automatic. */
  aiCategorizationMode String                @default("OFF")
  /**
   * Encrypted Anthropic API key for BYOK mode (AES-256-GCM, base64).
   * NULL when SERVER or OFF; never returned by the API.
   */
  aiApiKeyEncrypted    String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  refreshTokens        RefreshToken[]
  sources              Source[]
  categories           Category[]
  transactions         Transaction[]
  importBatches        ImportBatch[]
  recurrences          Recurrence[]
  categorizationRules  CategorizationRule[]
  installmentPlans     InstallmentPlan[]
  chatGptConnection    ChatGptConnection?
}

model Source {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String
  /** Statement closing day (1–31). Required when type is CREDIT_CARD; must be null otherwise. */
  closingDay     Int?
  /** Payment due day (1–31). Required when type is CREDIT_CARD; must be null otherwise. */
  dueDay         Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]
  importBatches      ImportBatch[]
  recurrences        Recurrence[]
  installmentPlans   InstallmentPlan[]
  csvMapping         CsvSourceMapping?

  @@unique([userId, name])
  @@index([userId])
}

/// Persists a confirmed `GenericCsvMapping` (see
/// `apps/api/src/imports/parsers/generic-csv-mapper.ts`) so a user maps a
/// bank's CSV export once and every later import from that `Source` reuses
/// it, editable in place -- one row per source (`sourceId` is unique).
///
/// `delimiter`/`hasHeader`/`encoding`/`dateColumn`/`descriptionColumn`/
/// `decimalSeparator`/`dateOrder` are the mapping's always-present scalar
/// fields. The enum-shaped ones among them are stored as TEXT + CHECK, like
/// every other former-enum column in this schema (see check-constraints.ts).
///
/// `signConfig` is different on purpose: it is the JSON-encoded
/// `GenericCsvSignConvention` discriminated union (signed_amount /
/// debit_credit / amount_and_type), kept as one opaque blob rather than
/// decomposed into per-variant nullable columns (an `amountColumn`, a
/// `debitColumn`, a `creditColumn`, a `typeColumn`, ...). Decomposing it
/// would make an invalid combination -- e.g. a `debit_credit` mapping that
/// also carries an `amountColumn` -- representable at the database layer
/// even though `GenericCsvMapping`'s TypeScript union makes that combination
/// unrepresentable in code. `signConfig` is re-validated by the mapper's own
/// `validateMapping` (invoked through `applyGenericCsvMapping`) every time it
/// is read back and applied, so a corrupted blob fails loudly instead of
/// silently parsing as a wrong mapping.
///
/// `columnCount` records how many columns the file had when this mapping was
/// confirmed. A later file with a different column count does not
/// necessarily mean the stored indices are out of range, but it is the
/// cheapest honest signal that the file's shape may have changed -- so
/// `CsvSourceMappingService` compares against it and surfaces a warning
/// rather than silently trusting stale column positions.
model CsvSourceMapping {
  id                String   @id @default(uuid())
  sourceId          String   @unique
  source            Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  delimiter         String
  hasHeader         Boolean
  encoding          String
  dateColumn        Int
  descriptionColumn Int
  decimalSeparator  String
  dateOrder         String
  signConfig        String
  columnCount       Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Category {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  type                 String
  categoryKey          String?
  parentId             String?
  parent               Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Category[]           @relation("CategoryHierarchy")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  transactions         Transaction[]
  recurrences          Recurrence[]
  categorizationRules  CategorizationRule[]

  @@unique([userId, name])
  @@unique([userId, categoryKey])
  @@index([userId])
  @@index([userId, parentId])
}

model SystemCategorizationRule {
  id          String            @id @default(uuid())
  pattern     String
  categoryKey String
  kind        String
  priority    Int
  ruleGroup   String
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([pattern])
  @@index([active, priority, pattern])
}

model CategorizationRule {
  id          String                   @id @default(uuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  priority    Int
  matchType   String
  pattern     String
  categoryId  String
  category    Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([userId, priority])
}

model ImportBatch {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId     String
  source       Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fileName     String
  format       String
  status       String             @default("COMPLETED")
  createdAt    DateTime           @default(now())
  transactions Transaction[]
  installmentPlans InstallmentPlan[]

  @@index([userId])
  @@index([sourceId])
}

/** Groups credit card installment legs for reconciliation (not the recurrence engine). */
model InstallmentPlan {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId           String
  source             Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  originatingBatchId String?
  originatingBatch   ImportBatch?  @relation(fields: [originatingBatchId], references: [id], onDelete: SetNull)
  installmentTotal   Int
  amountEachCents    Int
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]

  @@index([userId])
  @@index([sourceId])
}

model Recurrence {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  amountCents  Int
  description  String
  sourceId     String?
  source       Source?              @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency    String
  startDate    DateTime
  endMode      String
  endDate      DateTime?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId       String?
  source         Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatchId  String?
  importBatch    ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  installmentPlanId String?
  installmentPlan   InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  /** True when this row is a future obligation generated from an installment purchase (not yet confirmed from a statement). */
  isProjected    Boolean           @default(false)
  /** True when the row was created or reconciled from a statement import (false for projected-only rows). */
  isConfirmedFromImport Boolean     @default(false)
  recurrenceId   String?
  recurrence     Recurrence?       @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  kind           String
  amountCents    Int
  description    String
  occurredAt     DateTime
  fingerprint    String?
  /** UTC calendar month (1–12) of the card billing cycle close; set only for credit card sources. */
  billingCycleMonth Int?
  /** UTC calendar year of the card billing cycle close; set only for credit card sources. */
  billingCycleYear  Int?
  /** Payment due date (UTC); set only for credit card sources. */
  expectedDueDate   DateTime?
  /** Installment index from statement (e.g. 2 of 12); credit card imports only. */
  installmentCurrent Int?
  /** Total installments from statement; credit card imports only. */
  installmentTotal   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, occurredAt])
  @@index([userId])
  @@index([userId, fingerprint])
  @@index([installmentPlanId])
  @@index([recurrenceId, occurredAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One ChatGPT plan-usage connection per user. Local compositions only;
/// the hosted chain gets the table but never populates it (see
/// verify-ai-hosted-composition.ts for why that boundary exists).
model ChatGptConnection {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Durable per-installation client ID issued by dynamic registration.
  /// Retained across disconnect: it is the `id_token` audience, and
  /// re-registering would invalidate every previously stored identity.
  clientId         String
  /// AES-256-GCM, base64. Access + refresh token and id_token. NULL after
  /// disconnect. Never returned by the API.
  tokensEncrypted  String?
  /// Rotated credentials persisted before their identity is verified, so a
  /// signing-key outage or restart resumes verification instead of reusing
  /// an already-consumed refresh token.
  pendingEncrypted String?
  /// Space-separated granted scopes. Refresh responses may omit `scope`;
  /// this is the fallback, not a downgrade signal.
  scopes           String
  /// Whether the account's plan actually grants plan usage.
  sharing          Boolean  @default(false)
  expiresAt        DateTime?
  subject          String?
  accountLabel     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
