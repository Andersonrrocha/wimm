PORT=3000
NODE_ENV=development

# PostgreSQL (required for API)
# Copy this file to .env in this directory. For a local DB, run from repo root:
#   docker compose up -d
# Then apply migrations:
#   pnpm --filter @wimm/api exec prisma migrate deploy
DATABASE_URL=postgresql://user:password@localhost:5432/wimm

# JWT access token (signing). Expiry in seconds (e.g. 900 = 15 minutes).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_SEC=900

# Opaque refresh tokens: lifetime in whole days
REFRESH_TOKEN_EXPIRES_DAYS=7

# Set to "false" in production after the first user is created to lock the
# /auth/register endpoint. Any other value (including unset) keeps registration open.
ALLOW_REGISTRATION=true

# AI categorization (Anthropic Claude Haiku 4.5).
# - ANTHROPIC_API_KEY backs users on aiCategorizationMode=SERVER. Optional;
#   leave unset to disable server-side AI for everyone (BYOK keeps working).
# - AI_KEY_ENCRYPTION_SECRET (required if any user uses BYOK) is hashed to
#   derive the AES-256-GCM key that encrypts BYOK tokens at rest. Min 16 chars.
#   Rotating it invalidates all stored BYOK keys; users will need to re-paste.
ANTHROPIC_API_KEY=
AI_KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-string-min-16-chars
