{
  "name": "@wimm/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "WIMM desktop client — personal finance tracking",
  "author": "WIMM",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "tsx ../../scripts/select-native-abi.ts electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.spec.json",
    "pretest": "tsx ../../scripts/select-native-abi.ts node",
    "test": "jest",
    "clean": "rm -rf out dist release",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.99.0",
    "@wimm/api": "workspace:*",
    "@wimm/shared": "workspace:*",
    "axios": "^1.15.0",
    "date-fns": "^4.1.0",
    "electron-store": "8",
    "electron-updater": "^6.8.3",
    "i18next": "^26.0.6",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "jest": "^30.3.0",
    "postcss": "^8.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.20.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.wimm.desktop",
    "productName": "Wimm",
    "copyright": "Copyright © WIMM",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@wimm/api/src/**/*",
      "!node_modules/@wimm/api/test/**/*",
      "!node_modules/@wimm/api/prisma/migrations/**/*",
      "!node_modules/@wimm/api/*.tsbuildinfo",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/react-router-dom/**/*",
      "!node_modules/react-i18next/**/*",
      "!node_modules/react-day-picker/**/*",
      "!node_modules/recharts/**/*",
      "!node_modules/date-fns/**/*",
      "!node_modules/i18next/**/*",
      "!node_modules/lucide-react/**/*",
      "!node_modules/@radix-ui/**/*",
      "!node_modules/@tanstack/**/*",
      "!node_modules/axios/**/*",
      "!node_modules/react-router/**/*",
      "!node_modules/react-redux/**/*",
      "!node_modules/@reduxjs/**/*",
      "!node_modules/es-toolkit/**/*",
      "!node_modules/victory-vendor/**/*",
      "!node_modules/date-fns-jalali/**/*",
      "!node_modules/immer/**/*",
      "!node_modules/@babel/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build-resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "andersonrrocha",
      "repo": "wimm"
    }
  }
}
