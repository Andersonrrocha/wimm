# Root-level environment reference (copy to apps/api/.env for backend)

# API
PORT=3000
NODE_ENV=development

# Database (local: `pnpm db:up` at repo root, then migrate in apps/api)
# DATABASE_URL=postgresql://user:password@localhost:5432/wimm

# Auth (copy to apps/api/.env)
# JWT_ACCESS_SECRET=
# JWT_ACCESS_EXPIRES_SEC=900
# REFRESH_TOKEN_EXPIRES_DAYS=7

# Desktop (copy to apps/desktop/.env — Vite; used at build time for packaged app)
# VITE_API_URL=http://localhost:3000/api
